@model ApplicantIndexViewModel
@{
    ViewData["Title"] = "Абитуриенты";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h3 mb-0">Справочник абитуриентов</h2>
                <a asp-action="Create" class="btn btn-primary">Добавить абитуриента</a>
            </div>

            <!-- Статистика (ваш стиль) -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card bg-primary text-white">
                        <div class="card-body">
                            <h5 class="card-title">@Model.Statistics.ApplicantCount</h5>
                            <p class="card-text">Всего абитуриентов</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body">
                            <h5 class="card-title">@Model.Statistics.CountPassing</h5>
                            <p class="card-text">Поступившие</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body">
                            <h5 class="card-title">@Model.Statistics.CountScoreMoreThan150</h5>
                            <p class="card-text">>150 баллов</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Таблица как в примере -->
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ФИО</th>
                                    <th>Пол</th>
                                    <th>Дата рождения</th>
                                    <th>Форма обучения</th>
                                    <th>Математика</th>
                                    <th>Русский</th>
                                    <th>Информатика</th>
                                    <th>Итого</th>
                                    <th>Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Applicants)
                                {
                                    <tr>
                                        <td>@item.FullName</td>
                                        <td>@(item.Gender == Gender.Male ? "Мужской" : "Женский")</td>
                                        <td>@item.BirthDay.ToString("dd.MM.yyyy")</td>
                                        <td>@(item.FormOfEducation == FormOfEducation.FullTime ? "Очная" : "Заочная")</td>
                                        <td>@item.MathExamScore</td>
                                        <td>@item.RussianLanguageExamScore</td>
                                        <td>@item.InformaticExamScore</td>
                                        <td>@(item.MathExamScore + item.RussianLanguageExamScore + item.InformaticExamScore)</td>
                                        <td>
                                            <a asp-action="Change" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Изменить</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Удалить</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@using DataGridView.Entities.Models

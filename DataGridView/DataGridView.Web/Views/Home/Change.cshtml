@using DataGridView.Entities.Models
@model ApplicantModel
@{
    ViewData["Title"] = "Редактировать абитуриента";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h4>Редактировать абитуриента</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Change" method="post">
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Gender" class="form-label"></label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">Выберите пол</option>
                                    <option value="Male">Мужской</option>
                                    <option value="Female">Женский</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="BirthDay" class="form-label"></label>
                                <input asp-for="BirthDay" class="form-control" type="date" />
                                <span asp-validation-for="BirthDay" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FormOfEducation" class="form-label"></label>
                                <select asp-for="FormOfEducation" class="form-select">
                                    <option value="">Выберите форму</option>
                                    <option value="FullTime">Очная</option>
                                    <option value="PartTime">Заочная</option>
                                </select>
                                <span asp-validation-for="FormOfEducation" class="text-danger"></span>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label asp-for="MathExamScore" class="form-label"></label>
                                <input asp-for="MathExamScore" class="form-control" type="number" min="0" max="100" />
                                <span asp-validation-for="MathExamScore" class="text-danger"></span>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label asp-for="RussianLanguageExamScore" class="form-label"></label>
                                <input asp-for="RussianLanguageExamScore" class="form-control" type="number" min="0" max="100" />
                                <span asp-validation-for="RussianLanguageExamScore" class="text-danger"></span>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label asp-for="InformaticExamScore" class="form-label"></label>
                                <input asp-for="InformaticExamScore" class="form-control" type="number" min="0" max="100" />
                                <span asp-validation-for="InformaticExamScore" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
